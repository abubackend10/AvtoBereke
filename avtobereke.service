[Unit]
Description=Gunicorn daemon for AvtoBereke Django Project
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/AvtoBereke
ExecStart=/home/ubuntu/AvtoBereke/venv/bin/gunicorn --config gunicorn.conf.py core.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target